# Sin scripts de instalación.
#
# Lo pide @ybouane/liquidglass: su package.json trae un postinstall que
# corre `patch-package`, que no está entre sus dependencias. Un `npm ci`
# limpio falla con código 127 —y eso tira el deploy—, así que los scripts
# van apagados.
#
# Verificado que no perdemos nada: su dist ya trae html-to-image
# empaquetado, no declara dependencias y no hace llamadas de red en
# runtime. El parche es de su build, no del consumidor.
#
# De paso es más seguro: ningún paquete ejecuta código al instalarse.
# Si algún día hace falta un paquete que SÍ necesite su script, hay que
# quitar esto y resolver el postinstall de liquidglass de otra forma.
ignore-scripts=true
