{
  "name": "gestion-alquileres",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app para administrar alquileres: contratos, actualizaciones por \u00edndice, cobranzas y liquidaciones.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b",
    "indices": "node scripts/actualizar-indices.mjs",
    "esquema": "bash scripts/probar-esquema.sh",
    "sincro": "node scripts/probar-sincronizacion.mjs",
    "documentos": "node scripts/probar-documentos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
